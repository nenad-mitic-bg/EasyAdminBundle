{
    "name": "easycorp/easyadmin-bundle",
    "type": "symfony-bundle",
    "description": "Admin generator for Symfony applications",
    "keywords": ["backend", "admin", "generator"],
    "homepage": "https://github.com/EasyCorp/EasyAdminBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Project Contributors",
            "homepage": "http://github.com/EasyCorp/easyadmin/blob/master/CONTRIBUTORS.md"
        }
    ],
    "require": {
        "doctrine/dbal": "^4",
        "doctrine/doctrine-bundle": "^3",
        "doctrine/orm": "^3",
        "pagerfanta/pagerfanta": "^4",
        "psr/log": "^3",
        "symfony/asset": "^8",
        "symfony/cache": "^8",
        "symfony/config": "^8",
        "symfony/dependency-injection": "^8",
        "symfony/doctrine-bridge": "^8",
        "symfony/event-dispatcher": "^8",
        "symfony/finder": "^8",
        "symfony/form": "^8",
        "symfony/framework-bundle": "^8",
        "symfony/http-foundation": "^8",
        "symfony/http-kernel": "^8",
        "symfony/polyfill-mbstring": "^1",
        "symfony/property-access": "^8",
        "symfony/routing": "^8",
        "symfony/security-bundle": "^8",
        "symfony/translation": "^8",
        "symfony/twig-bridge": "^8",
        "symfony/twig-bundle": "^8",
        "symfony/validator": "^8",
        "twig/twig": "^3"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4",
        "psr/log": "^3",
        "symfony/browser-kit": "^8",
        "symfony/console": "^8",
        "symfony/css-selector": "^8",
        "symfony/dom-crawler": "^8",
        "symfony/phpunit-bridge": "^8",
        "symfony/var-dumper": "^8",
        "symfony/yaml": "^8"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "EasyCorp\\Bundle\\EasyAdminBundle\\": "src/",
            "JavierEguiluz\\Bundle\\EasyAdminBundle\\": "legacy/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AppTestBundle\\": "tests/Fixtures/AppTestBundle/",
            "EasyCorp\\Bundle\\EasyAdminBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.17.x-dev"
        }
    }
}
